local script = nil
--!strict
--[[ Emulator/Hardware/Timers.luau

 Four cascadable 16-bit timers. Each preserves its cycle remainder across ticks
 so timing stays accurate regardless of how many cycles the CPU hands us at once.

   REG_TMxCNT (16-bit): bit7 enable, bit6 irq, bits4-5 cascade, bits0-1 prescaler
 ]]

local PRESCALE = { 1, 64, 256, 1024 }

local Timers = {}
Timers.__index = Timers

function Timers.new(interrupts: any)
	local timers = { interrupts = interrupts, list = {} }
	for i = 1, 4 do
		timers.list[i] = {
			counter = 0, reload = 0, control = 0,
			enabled = false, irq = false, cascade = false, prescale = 1,
			prescaleCounter = 0,
		}
	end
	return setmetatable(timers, Timers) :: any
end

local function decodeControl(t): nil
	local c = t.control
	t.prescale = PRESCALE[bit32.band(c, 3) + 1]
	t.cascade = bit32.band(c, 0x4) ~= 0
	t.irq = bit32.band(c, 0x40) ~= 0
	t.enabled = bit32.band(c, 0x80) ~= 0
end

function Timers:read16(addr: number): number
	local index = (addr - 0x100) // 4 + 1
	local t = self.list[index]
	if not t then return 0 end
	local reg = (addr - 0x100) % 4
	if reg == 0 then return t.counter end
	if reg == 2 then return t.control end
	return 0
end

function Timers:write16(addr: number, value: number)
	local index = (addr - 0x100) // 4 + 1
	local t = self.list[index]
	if not t then return end
	local reg = (addr - 0x100) % 4
	if reg == 0 then
		t.reload = bit32.band(value, 0xFFFF)
		if not t.enabled then t.counter = t.reload end
	elseif reg == 2 then
		local wasEnabled = t.enabled
		t.control = bit32.band(value, 0xFF)
		decodeControl(t)
		if t.enabled and not wasEnabled then
			t.counter = t.reload
			t.prescaleCounter = 0
		end
	end
end

--- Advance all timers by `cycles` CPU cycles.
function Timers:tick(cycles: number)
	for i = 1, 4 do
		local t = self.list[i]
		if not t.enabled then continue end
		if t.cascade then
			-- cascaded timers are clocked by the overflow of the previous one,
			-- handled inline below; skip here.
			continue
		end
		local inc = 0
		if t.prescale == 1 then
			inc = cycles
		else
			t.prescaleCounter += cycles
			inc = t.prescaleCounter // t.prescale
			t.prescaleCounter -= inc * t.prescale
		end
		Timers._advance(self, i, inc)
	end
end

--- Add `delta` ticks to timer `i`, cascading overflows to the next timer.
function Timers._advance(self, i: number, delta: number)
	if delta <= 0 then return end
	local t = self.list[i]
	local remaining = 0x10000 - t.counter
	if delta >= remaining then
		local period = 0x10000 - t.reload
		local overflows = 1 + (delta - remaining) // period
		t.counter = t.reload + (delta - remaining) % period
		if t.irq then self.interrupts:raise(2 + i) end
		if self.onOverflow then self.onOverflow(i - 1, overflows) end
		local nextT = self.list[i + 1]
		if nextT and nextT.enabled and nextT.cascade then Timers._advance(self, i + 1, overflows) end
	else
		t.counter += delta
	end
end

function Timers:reset()
	for i = 1, 4 do
		self.list[i] = { counter = 0, reload = 0, control = 0, enabled = false, irq = false, cascade = false, prescale = 1, prescaleCounter = 0 }
	end
end

return Timers

end

__factories["StarterPlayer/StarterPlayerScripts/GBAClient/Emulator/ROMLoader"] = function()
-- Bundled modules have no individual script Instances. Source reports are prebuilt.
local script = nil
--!strict
--[[ Emulator/ROMLoader.luau

 Finds a ROM that has been baked into the place, since a Roblox client cannot
 read local files. Three supported shapes, checked in order:

   ReplicatedStorage.Assets.ROM     ModuleScript returning {string} (base64
                                    chunks, produced by web/rom-tool.html) or
                                    {number} (raw bytes)
   ReplicatedStorage.GBAROM         StringValue holding base64
   ReplicatedStorage.GBAROM (Folder) ordered StringValue chunks named 1, 2, 3...

 The web tool in web/ generates exactly these shapes, so the workflow is:
 drop a ROM in the tool -> download ROM.luau -> put it in src/Assets/ -> Rojo
 syncs it -> the client auto-loads on join.
 ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Base64 = __load("ReplicatedStorage/Shared/Base64")
local Util = __load("ReplicatedStorage/Shared/Util")

local ROMLoader = {}

local MAX_ROM = 32 * 1024 * 1024

local function fromModule(inst: Instance): ({ number }?, string?)
	local ok, data = pcall(function()
		return require(inst :: any)
	end)
	if not ok or type(data) ~= "table" or #data == 0 then return nil, nil end
	local first = data[1]
	if type(first) == "string" then
		assert(#table.concat(data) <= math.ceil(MAX_ROM / 3) * 4, "Embedded ROM exceeds 32 MiB")
		local bytes = Base64.decodeToBuffer(table.concat(data))
		return bytes, "Assets.ROM (base64 chunks)"
	elseif type(first) == "number" then
		assert(#data <= MAX_ROM, "Embedded ROM exceeds 32 MiB")
		return Util.bytesToBuffer(data), "Assets.ROM (byte table)"
	end
	return nil, nil
end

local function fromFolder(folder: Instance): ({ number }?, string?)
	local parts = {}
	for _, child in folder:GetChildren() do
		if child:IsA("StringValue") then
			table.insert(parts, { tonumber(child.Name) or 0, child.Value })
		end
	end
	if #parts == 0 then return nil, nil end
	table.sort(parts, function(a, b) return a[1] < b[1] end)
	local joined = table.create(#parts)
	for i, p in parts do joined[i] = p[2] end
	assert(#table.concat(joined) <= math.ceil(MAX_ROM / 3) * 4, "Embedded ROM exceeds 32 MiB")
	return Base64.decodeToBuffer(table.concat(joined)), "GBAROM (chunk folder)"
end

--- Locate an embedded ROM. Returns (bytes, sourceName) or (nil, reason).
function ROMLoader.find(): ({ number }?, string?)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if assets then
		local mod = assets:FindFirstChild("ROM")
		if mod and mod:IsA("ModuleScript") then
			local bytes, name = fromModule(mod)
			if bytes then
				if buffer.len(bytes) > MAX_ROM then return nil, "embedded ROM exceeds 32 MiB" end
				return bytes, name
			end
		end
	end

	local holder = ReplicatedStorage:FindFirstChild("GBAROM")
	if holder then
		local bytes, name
		if holder:IsA("StringValue") then
			assert(#holder.Value <= math.ceil(MAX_ROM / 3) * 4, "Embedded ROM exceeds 32 MiB")
			bytes, name = Base64.decodeToBuffer(holder.Value), "GBAROM (StringValue)"
		elseif holder:IsA("Folder") then
			bytes, name = fromFolder(holder)
		end
		if bytes and buffer.len(bytes) > 0 then
			if buffer.len(bytes) > MAX_ROM then return nil, "embedded ROM exceeds 32 MiB" end
			return bytes, name
		end
	end

	return nil, "no embedded ROM found"
end

return ROMLoader

end

__factories["StarterPlayer/StarterPlayerScripts/GBAClient/Emulator/Save/SaveBackend"] = function()
