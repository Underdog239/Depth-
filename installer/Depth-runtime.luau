-- Check required capabilities, not Studio or execution-mode flags.
local __player = assert(game:GetService("Players").LocalPlayer,
    "Depth needs Players.LocalPlayer. Run this in a Roblox player client.")
local __gui = assert(__player:WaitForChild("PlayerGui", 10),
    "Depth could not find PlayerGui after 10 seconds. Wait for the player to finish loading and retry.")
if __gui:FindFirstChild("LuauGBA") then
    warn("Depth is already running for this player; keeping the existing session.")
    return
end

-- The browser helper can pass a private ROM as the chunk's first argument.
local __romText = ...
if __romText ~= nil then
    assert(type(__romText) == "string" and #__romText <= 44739244,
        "Depth launcher ROM must be base64 text for a ROM up to 32 MiB.")
    local __bytes = __load("ReplicatedStorage/Shared/Base64").decodeToBuffer(__romText)
    __romText = nil
    assert(buffer.len(__bytes) >= 192 and buffer.len(__bytes) <= 33554432,
        "Depth launcher ROM must be between 192 bytes and 32 MiB.")
    __load("StarterPlayer/StarterPlayerScripts/GBAClient/Emulator/ROMLoader").find = function()
        local bytes = __bytes
        __bytes = nil
        return bytes, "client launcher"
    end
end

