	describeBinding = function(bit) return input:describe(bit) end,
	onLowPower = function(enabled) adaptive:setLowPower(enabled) end,
	onMute = function(muted) audio:setMuted(muted) end,
	onAudioAsset = function(text) return audio:setAsset(text) end,
	onTestTone = function() return audio:testTone() end,
	onDemo = function() loadRomBytes(DemoROM.create()) end,
	onLoadROM = function(bytes: buffer)
		return loadRomBytes(bytes)
	end,
	onPlayPause = function()
		if not running then return false end
		paused = not paused
		return not paused
	end,
	onReset = function()
		if not gba.cart then return end
		gba:reset()
		running, paused = true, false
		ui:setRunning(true)
		ui:setStatus("Reset complete")
	end,
	onScale = function(scale: number)
		renderer:setScale(scale)
	end,
	onSaveState = function()
		if not gba.cart then ui:setStatus("Load a ROM first"); return end
		savedState = SaveState.save(gba)
		ui:setStatus("state saved (in memory)")
	end,
	onLoadState = function()
		if savedState and SaveState.load(gba, savedState) then
			running = true
			renderer:present(gba:framebuffer(), true)
			ui:setRunning(not paused)
			ui:setStatus("State restored")
		else
			ui:setStatus("no saved state yet")
		end
	end,
	onExportSave = function()
		if not gba.cart then ui:setStatus("Load a ROM first"); return nil end
		ui:setStatus("Copy the save text and keep it in a file to import next session")
		return Base64.encode(gba:saveBytes())
	end,
	onImportSave = function(text)
		if not gba.cart then ui:setStatus("Load a ROM first"); return end
		local ok, bytes = pcall(Base64.decode, text)
		if not ok or #bytes ~= gba.cart.backend.size then ui:setStatus("Save data is invalid or has the wrong size for this game"); return end
		gba:loadSaveBytes(bytes)
		gba:reset()
		savedState = nil
		running, paused = true, false
		ui:setRunning(true)
		ui:setStatus("Battery save imported; game restarted")
	end,
	onToggleDiag = function()
		dashboard:toggle()
	end,
}

ui = UI.new(hooks)
renderer = Renderer.new(ui.screenHost, { scale = Config.RENDER.scale })
input = InputManager.new()
input:setEnabled(false)
input.onMenu = function() ui:showMenu(not ui.open) end
ui:updateBindings()
UIS.WindowFocusReleased:Connect(function()
	focused = false; input:setEnabled(false); audio:setActive(false); audio:stopTest()
end)
UIS.WindowFocused:Connect(function()
	focused = true; input:setEnabled(not menuOpen)
end)
dashboard = Dashboard.new(Diagnostics, ui.gui.Parent)

-- 3. Embedded ROM auto-load ---------------------------------------------------
task.spawn(function()
	local ok, bytes, source = pcall(ROMLoader.find)
	if not ok then ui:setStatus("Embedded ROM failed: " .. tostring(bytes)); return end
	if bytes then
		Logger.info(`embedded ROM found via {source} ({buffer.len(bytes) // 1024} KiB)`)
		if loadRomBytes(bytes) then ui:showMenu(false) end
	else
		ui:setStatus("Ready when you are. Try Run demo, or open Library to add your game.")
	end
end)

-- 4. Invariants the catcher checks in the background --------------------------
Diagnostics.registerInvariant("cpu.pc.inrange", function()
	local pc = gba.cpu.regs[16]
	return pc >= 0 and pc < 0x10000000, `PC out of range: 0x{string.format("%08X", pc)}`
end)
Diagnostics.registerInvariant("cpu.mode.valid", function()
	local m = gba.cpu.mode
	local ok = m == 0x10 or m == 0x11 or m == 0x12 or m == 0x13 or m == 0x17 or m == 0x1B or m == 0x1F
	return ok, `invalid CPSR mode 0x{string.format("%02X", m)}`
end)
Diagnostics.registerInvariant("ppu.line.inrange", function()
	local line = gba.ppu.line
	return line >= 0 and line <= 227, `PPU line out of range: {line}`
end)
Diagnostics.registerInvariant("save.size.valid", function()
	local backend = gba.cart and gba.cart.backend
	if not backend or backend.type == "NONE" then return true end
	return backend.size > 0 and #backend.data == backend.size, "save backend size mismatch"
end)

-- 5. Frame loop ---------------------------------------------------------------
local function onFrame(dt: number)
	local frameStart = os.clock()
	frameIndex += 1

	local playing = running and not paused and not menuOpen and focused
	audio:setActive(playing)
	if playing then
		emulationDebt = math.min(emulationDebt + dt, 2 / Config.FPS)
	end
	if playing and emulationDebt >= 1 / Config.FPS then
		gba:setKeys(input.mask)
		watchdog:beginFrame(frameIndex)
		profiler:beginSection("emulate")
		local ok, err = pcall(function() gba:runFrame(adaptive.sliceMs) end)
		profiler:endSection("emulate")
		watchdog:endFrame(frameIndex, gba.bus.cycles)
		if not ok then
			Diagnostics.report(`emulation error: {err}`, { source = "frameLoop", kind = "runtime-error", severity = "error", stack = debug.traceback() })
			running = false
			audio:setActive(false)
			ui:setRunning(false)
			ui:setStatus("Emulation stopped: " .. tostring(err))
		end


		if gba.ppu.frameComplete then
			emulationDebt = math.max(0, emulationDebt - 1 / Config.FPS)
		end
		if gba.ppu.frameComplete and adaptive:shouldPresent(gba.ppu.frame) then
			profiler:beginSection("present")
			local okP, errP = pcall(function() renderer:present(gba:framebuffer()) end)
			profiler:endSection("present")
			if not okP then
				Diagnostics.report(`present error: {errP}`, { source = "renderer", kind = "runtime-error", severity = "error" })
			end
		end
	end

	local frameMs = math.max(dt, os.clock() - frameStart) * 1000
	if playing then adaptive:sample(frameMs) end
	audio:pump()
	if frameIndex % 60 == 0 then ui:setAudioStatus(audio:status()) end

	if frameIndex % 30 == 0 then
		local p = profiler:report()
		-- UI refresh is throttled independently of emulation.
		ui:setMetrics(string.format("%s | work %.1fms | budget %.0fms | %.0f FPS",
			renderer.backend, p.emulate or 0, adaptive.sliceMs, 1000 / adaptive.averageMs))
	end
end

RunService.RenderStepped:Connect(function(dt)
	local ok, err = pcall(onFrame, dt)
	if not ok then
		running = false
		audio:setActive(false)
		ui:setRunning(false)
		ui:setStatus("Frame error: " .. tostring(err))
		Diagnostics.report(`frame loop crashed: {err}`, { source = "RenderStepped", kind = "runtime-error", severity = "fatal" })
	end
end)

Logger.info(`LuauGBA {Config.VERSION} online - diagnostics catcher running in the background`)

end

__factories["StarterPlayer/StarterPlayerScripts/GBAClient/Audio"] = function()
-- Bundled modules have no individual script Instances. Source reports are prebuilt.
local script = nil
--!strict
-- Public Roblox APIs cannot stream the APU's PCM buffer. An optional uploaded
-- 256 Hz square-wave loop approximates PSG channels 1/2; wave/noise/FIFO audio
-- is not synthesized by this adapter. It never claims full game-audio playback.
local Config = __load("ReplicatedStorage/Shared/Config")
local Audio = {}
Audio.__index = Audio
function Audio.new(apu)
	local self = setmetatable({apu=apu,level=0,peak=0,samples=0,batches=0,
		muted=false,active=false,lastUpdate=0,asset="",sounds={},testUntil=0},Audio)
	for i=1,3 do
		local sound = Instance.new("Sound")
		sound.Name = "DepthTone" .. i; sound.Looped = true; sound.Volume = 0
		sound.Parent = game:GetService("SoundService"); self.sounds[i] = sound
	end
	apu:setSink(function(batch) self:_onSamples(batch) end)
	if Config.AUDIO.squareAssetId ~= "" then self:setAsset(Config.AUDIO.squareAssetId) end
	return self
end
function Audio:_onSamples(batch)
	local sum,peak = 0,0
	for _,value in batch do sum += value*value; peak=math.max(peak,math.abs(value)) end
	self.samples += #batch; self.batches += 1
	self.level = self.level*0.8 + math.min(#batch>0 and math.sqrt(sum/#batch)/128 or 0,1)*0.2
	self.peak = math.max(peak/128,self.peak*0.92)
end
function Audio:setAsset(text)
	local id = text:match("^%s*(%d+)%s*$") or text:match("^rbxassetid://(%d+)$")
	if not id or #id > 20 or tonumber(id) == 0 then return "Enter the numeric ID of your uploaded 256 Hz square-wave loop" end
	self.asset = "rbxassetid://" .. id
	for _,sound in self.sounds do sound:Stop(); sound.SoundId=self.asset end
	return "Audio asset set. Press Test tone; the experience must have permission to use this asset."
end
function Audio:setMuted(muted)
	self.muted=muted
	if muted then for _,sound in self.sounds do sound:Stop() end end
end
function Audio:setActive(active)
	if active == self.active then return end
	self.active=active
	if not active then for i=1,2 do self.sounds[i]:Stop() end end
end
function Audio:stopTest() self.testUntil=0; self.sounds[3]:Stop() end
function Audio:testTone()
	if self.asset == "" then return "Upload Depth-square-256Hz.wav and enter its Roblox asset ID first" end
	if self.muted then return "Unmute audio before testing" end
	self.testUntil=os.clock()+1
	local sound=self.sounds[3]; sound.PlaybackSpeed=1; sound.Volume=0.2; sound:Play()
	return sound.IsLoaded and "Playing a one-second test tone" or "Audio loading; check asset permissions in Studio Output if silent"
end
function Audio:pump()
	self.apu:flush()
	local now=os.clock()
	if now>=self.testUntil and self.sounds[3].IsPlaying then self.sounds[3]:Stop() end
	if now-self.lastUpdate < 1/20 then return end
	self.lastUpdate=now
	local control=self.apu:read16(0x080)
	local right=bit32.band(control,7)/7
	local left=bit32.band(bit32.rshift(control,4),7)/7
	for i=1,2 do
		local sound,ch=self.sounds[i],self.apu.ch[i]
		local routing=math.max(bit32.band(control,bit32.lshift(1,7+i))~=0 and right or 0,
			bit32.band(control,bit32.lshift(1,11+i))~=0 and left or 0)
		local audible=self.active and not self.muted and self.asset~="" and self.apu.masterEnable and ch.enabled and routing>0
		if audible then
			sound.PlaybackSpeed=math.clamp((131072/math.max(2048-ch.freq,1))/256,0.05,20)
			sound.Volume=math.clamp(ch.envVol/15*routing*Config.AUDIO.master*0.3,0,1)
			if not sound.IsPlaying then sound:Play() end
		elseif sound.IsPlaying then sound:Stop() end
	end
end
function Audio:status()
	if self.asset=="" then return "Audio setup needed: no waveform asset. Full PCM playback is unavailable on Roblox clients." end
	if not self.sounds[3].IsLoaded then return "Audio asset loading or inaccessible. Use Test tone and check experience permissions." end
	return self.muted and "Muted" or "Approximate square-channel audio ready. PCM music, wave and noise are not played."
end
function Audio:stats() return {level=self.level,peak=self.peak,samples=self.samples,batches=self.batches} end
function Audio:destroy()
	self.apu:setSink(nil)
	for _,sound in self.sounds do sound:Destroy() end
end
return Audio

end

__factories["StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics"] = function()
-- Bundled modules have no individual script Instances. Source reports are prebuilt.
local script = nil
--!strict
--[[ Diagnostics (init)

 The always-on catcher. Compose the pieces and expose a tiny API:

   local Diag = require(...Diagnostics)
   Diag.install()                     -- once, at boot
   Diag.capture({ message = ..., kind = ... })
   Diag.registerInvariant("bus.bounds", fn)
   Diag.summary()                     -- { error = n, bug = n, ... }
   Diag.findings({ category = "unfinished" })
   Diag.advice(finding)               -- suggested fix text

 Background behaviour: install() starts a task loop that (a) static-scans the
 emulator's own scripts and (b) runs every registered invariant. Findings stay
 in memory on this client for the current session. It also records the last
 scan time so the dashboard can show when it ran.
 ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = __load("ReplicatedStorage/Shared/Config")
local Logger = __load("ReplicatedStorage/Shared/Logger")
local Signal = __load("ReplicatedStorage/Shared/Signal")

local Classifier = __load("StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/Classifier")
local Store = __load("StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/Store")
local StaticScan = __load("StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/StaticScan")
local Watchdog = __load("StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/Watchdog")
local Hooks = __load("StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/Hooks")
local BuildReport = __load("ReplicatedStorage/Shared/BuildReport")

type Finding = Classifier.Finding

type Invariant = { name: string, fn: () -> (boolean, string?) }

local Diag = {}
Diag.VERSION = Config.VERSION

Diag.onFinding = Signal.new()
Diag._store = Store.new(Config.DIAG.maxEvents)
Diag._invariants = {} :: { Invariant }
Diag._installed = false
Diag._lastScan = 0
Diag._scanRuns = 0
Diag._backgroundTask = nil :: thread?
Diag._sourceScanned = false

-- Core capture --------------------------------------------------------------

--- Ingest any raw signal and store a classified finding.
function Diag.capture(signal: {
	message: string,
	source: string?,
	kind: string?,
	stack: string?,
	hint: string?,
	meta: { [string]: any }?,
}): Finding
	if not Config.DIAG.enabled then
		return nil :: any
	end
	local finding = Classifier.makeFinding(signal)
	local stored = Diag._store:add(finding)
	Diag.onFinding:fire(stored)
	-- The originating error is already logged. Logging findings back into the
	-- observed Logger/LogService creates recursive findings.

	return stored
end

--- Convenience wrappers used across the emulator.
function Diag.report(message: string, meta: { [string]: any }?)
	Diag.capture({
		message = message,
		stack = meta and meta.stack,
		source = (meta and meta.source) or "manual",
		kind = (meta and meta.kind) or nil,
		hint = (meta and meta.severity) or nil,
		meta = meta,
	})
end

--- Wrap a hot-path function so any error is recorded and swallowed safely.
function Diag.guard(name: string, fn: (...any) -> ...any)
	return Hooks.guard(name, fn, function(sig) Diag.capture(sig) end)
end

--- Register a runtime invariant checked by the background loop.
function Diag.registerInvariant(name: string, fn: () -> (boolean, string?))
	table.insert(Diag._invariants, { name = name, fn = fn })
end

-- Queries -------------------------------------------------------------------

function Diag.findings(filter: { category: string?, minSeverity: string? }?)
	filter = filter or {}
	local out = {}
	for _, f in Diag._store:all() do
		if filter.category and f.category ~= filter.category then continue end
		out[#out + 1] = f
	end
	return out
end

function Diag.summary()
	return {
		counts = Diag._store:countByCategory(),
		total = Diag._store:count(),
		lastScan = Diag._lastScan,
		scanRuns = Diag._scanRuns,
		stalls = 0,
		sourceHash = BuildReport.sourceHash,
	}
end

--- Human-readable fix suggestion for a finding ("then you can fix it").
function Diag.advice(finding: Finding): string
	local a = {
		error = "Wrap the failing path in Diag.guard and fix the root cause in the referenced module.",
		bug = "Inspect the reported module; likely an off-by-one / bounds / wrap issue. Add an invariant.",
		vulnerability = "Never trust client input: validate on the server, drop loadstring/getfenv, scope remotes.",
		unfinished = "Finish the stub or clearly mark the feature disabled until implemented.",
	}
	local base = a[finding.category] or "Review the referenced source."
	if finding.meta and finding.meta.snippet then
		base = base .. ` Offending line: {finding.meta.snippet}`
	end
	return base
end

-- Background behaviour ------------------------------------------------------

local function runScan()
	Diag._lastScan = os.clock()
	Diag._scanRuns += 1

	-- Source is immutable/protected in ordinary clients. Probe only once.
	if not Diag._sourceScanned then
		Diag._sourceScanned = true
		local ok, hits = false, nil
		if script then
			ok, hits = pcall(StaticScan.scanInstance, script.Parent, {maxLines = 2000})
		end
		if ok and hits then
			for _, f in StaticScan.toFindings(hits) do Diag.onFinding:fire(Diag._store:add(f)) end
		end
	end

	-- (b) invariants
	for _, inv in Diag._invariants do
		local okI, holds, detail = pcall(inv.fn)
		if not okI then
			Diag.capture({ message = `invariant '{inv.name}' errored: {holds}`, source = "invariant", kind = "runtime-error", hint = "error" })
		elseif not holds then
			Diag.capture({ message = `invariant '{inv.name}' violated: {detail or "no detail"}`, source = "invariant", kind = "bug", hint = "warn" })
		end
	end
end

--- Start the background monitor. Returns immediately.
function Diag.install()
	if Diag._installed then return end
	Diag._installed = true
	for _, entry in BuildReport.findings do
		local finding = Classifier.makeFinding({message=entry.message,
			source=entry.source .. ":" .. entry.line, hint=entry.severity, kind=entry.category})
		finding.category = entry.category
		finding.symbol = Classifier.symbolFor(entry.category, entry.message, finding.source)
		Diag._store:add(finding)
	end

	Logger.attachSink(function(level, msg)
		if level == "error" or level == "fatal" or level == "warn" then
			Diag.capture({ message = msg, source = "Logger", kind = level })
		end
	end)

	Hooks.install(function(sig) Diag.capture(sig) end)

	Diag._backgroundTask = task.spawn(function()
		local interval = Config.DIAG.scanInterval
		while Diag._installed do
			task.wait(interval)
			pcall(runScan)
		end
	end)
	Logger.info("DIAG background catcher online (static scan + invariants)")
end

function Diag.setWatchdogReporter(wd: any)
	if wd and wd.setReporter then
		wd:setReporter(function(msg, meta) Diag.report(msg, meta) end)
	end
end

function Diag.shutdown()
	Diag._installed = false
	if Diag._backgroundTask then task.cancel(Diag._backgroundTask); Diag._backgroundTask = nil end
	Hooks.uninstall()
	Diag.onFinding:clear()
end

-- Expose pure modules for tests
Diag._classifier = Classifier
Diag._storeFactory = Store
Diag._staticScan = StaticScan
Diag._watchdogFactory = Watchdog

return Diag

end

__factories["StarterPlayer/StarterPlayerScripts/GBAClient/Diagnostics/Classifier"] = function()
-- Bundled modules have no individual script Instances. Source reports are prebuilt.
local script = nil
--!strict
--[[ Diagnostics/Classifier.luau

 Turns raw signals (runtime errors, static-analysis hits, invariant failures)
 into a normalized Finding with one of four categories the user asked for:

   * "error"         -- something actually blew up at runtime
   * "bug"           -- logically wrong / inconsistent behaviour
   * "vulnerability" -- security or exploit-adjacent weakness
   * "unfinished"    -- stubbed / TODO / placeholder code paths

 Classification is heuristic but deterministic and unit-tested in Tests/.
 ]]

type Category = "error" | "bug" | "vulnerability" | "unfinished"
type Severity = "info" | "warn" | "error" | "fatal"

type Finding = {
	id: string,
	category: Category,
	severity: Severity,
	message: string,
	source: string,       -- originating subsystem
	symbol: string,       -- dedup key
	stack: string?,
	count: number,
	firstSeen: number,
	lastSeen: number,
	meta: { [string]: any }?,
}

local Classifier = {}

-- Patterns are checked in priority order; first match wins per category.

local VULN_PATTERNS = {
	{ "RemoteEvent without server validation", "%f[%a]remoteevent%f[%A]" },
	{ "FireServer/FireAllClients of untrusted data", "fireserver|fireallclients" },
	{ "loadstring / dynamic code execution", "%f[%a]loadstring%f[%A]" },
	{ "getfenv/setfenv usage", "[gs]etfenv" },
	{ "HttpService on the client", "httpservice" },
	{ "DataStore write from client", "datastoreservice" },
	{ "require of untrusted user asset", "require%(%s*%d+" },
	{ "unbounded loop over network data", "while%s+true" },
	{ "string as bytecode / obfuscation marker", "\\%d\\%d\\%d\\%d" },
}

local UNFINISHED_PATTERNS = {
	{ "TODO marker", "TODO" },
	{ "FIXME marker", "FIXME" },
	{ "XXX/HACK marker", "XXX|HACK" },
	{ "placeholder / stub", "placeholder|stub|not%s+implemented|NYI" },
	{ "unimplemented instruction", "unimplemented|unsupported%s+opcode|opcode%%?%%?" },
	{ "empty function body", "function[%w_%.]*%b()%s*return%s*end" },
	{ "error('not implemented')", "error%(%s*['\"]not" },
}

local BUG_PATTERNS = {
	{ "integer overflow without wrap", "0x100000000" },
	{ "index nil", "attempt to index nil" },
	{ "nil arithmetic", "attempt to perform arithmetic" },
	{ "out of bounds memory access", "out of bounds|oob access" },
	{ "infinite recursion", "stack overflow" },
	{ "type mismatch", "type mismatch" },
	{ "division by zero", "divide by zero|division by zero" },
}

local function containsAny(hay: string, patterns: { { string } }): string?
	for _, entry in patterns do
		local matched = false
		for alternative in string.gmatch(entry[2], "[^|]+") do
			if string.find(hay, alternative) then matched = true; break end
		end
		if matched then
			return entry[1]
		end
	end
	return nil
end

--- Derive severity from category + explicit hints.
local function severityFor(category: Category, hint: string?): Severity
	if hint == "fatal" or hint == "error" or hint == "warn" or hint == "info" then return hint :: Severity end
	if category == "error" then return "error" end
	if category == "vulnerability" then return "warn" end
	if category == "bug" then return "warn" end
	return "info"
end

--- Stable dedup symbol: category + normalized message + source.
function Classifier.symbolFor(category: Category, message: string, source: string): string
	-- strip numbers/addresses so "read8(0x1FF)" and "read8(0x200)" dedup.
	local norm = message:gsub("0x%x+", "N"):gsub("%d+", "N"):gsub("[%w_]+%.luau", "FILE")
	return `{category}|{source}|{norm}`
end

--- Classify a raw text signal into a category.
function Classifier.classify(message: string, source: string, kind: string?): Category
	local lower = string.lower(message)

	-- Explicit kind wins if the caller already knows.
	if kind == "runtime-error" or kind == "error" then
		-- but a security-flavoured error is still a vulnerability
		if containsAny(lower, VULN_PATTERNS) then return "vulnerability" end
		return "error"
	end

	local vuln = containsAny(lower, VULN_PATTERNS)
	if vuln then return "vulnerability" end

	local unf = containsAny(message, UNFINISHED_PATTERNS)
	if unf then return "unfinished" end

	local bug = containsAny(lower, BUG_PATTERNS)
	if bug then return "bug" end

	source = source or ""
	if string.find(lower, "attempt to") or string.find(lower, "stack overflow") then
		return "error"
	end
	return "bug"
end

--- Human-readable reason for a category decision (for dashboards/tooltips).
function Classifier.explain(message: string, source: string, kind: string?): string
	local lower = string.lower(message)
	local hit = containsAny(lower, VULN_PATTERNS)
	if hit then return `security signal: {hit}` end
	hit = containsAny(message, UNFINISHED_PATTERNS)
	if hit then return `incomplete code signal: {hit}` end
	hit = containsAny(lower, BUG_PATTERNS)
	if hit then return `correctness signal: {hit}` end
	if kind == "runtime-error" then return "uncaught runtime error" end
	return "default heuristic"
end

--- Build a Finding from a signal. Time is injectable for tests.
function Classifier.makeFinding(signal: {
	message: string,
	source: string?,
	kind: string?,
	stack: string?,
	meta: { [string]: any }?,
	hint: string?,
}, nowFn: (() -> number)?): Finding
	local nowFn2 = nowFn or os.clock
	local source = signal.source or "unknown"
	local message = signal.message or ""
	local category = Classifier.classify(message, source, signal.kind)
	local symbol = Classifier.symbolFor(category, message, source)
	return {
		id = symbol,
		category = category,
		severity = severityFor(category, signal.hint),
		message = message,
		source = source,
		symbol = symbol,
		stack = signal.stack,
		count = 1,
		firstSeen = nowFn2(),
		lastSeen = nowFn2(),
